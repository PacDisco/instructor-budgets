{
  "//": "Bubblewrap config for the Field Budget TWA. Copy to twa-manifest.json,",
  "//host": "replace budget.pacificdiscovery.org with your real hostname, then",
  "//run": "run: bubblewrap build",

  "packageId": "org.pacificdiscovery.fieldbudget",
  "host": "budget.pacificdiscovery.org",
  "name": "Pacific Discovery Field Budget",
  "launcherName": "Field Budget",
  "display": "standalone",
  "orientation": "portrait",
  "themeColor": "#FFFFFF",
  "themeColorDark": "#FFFFFF",
  "navigationColor": "#FFFFFF",
  "navigationColorDark": "#FFFFFF",
  "navigationDividerColor": "#DEE2E6",
  "navigationDividerColorDark": "#DEE2E6",
  "backgroundColor": "#FFFFFF",
  "enableNotifications": false,
  "startUrl": "/",
